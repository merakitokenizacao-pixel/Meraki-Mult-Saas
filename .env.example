# Supabase (projeto VoraX). A anon key é pública (segura no front).
# Pegue os valores no painel do Supabase. NUNCA commitar a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://sflpxenfyewefzwizimf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: usada APENAS em código server-side (a página pública /ficha e o
# route handler /api/ficha). Ignora a RLS. Sem o prefixo NEXT_PUBLIC_ ela nunca
# entra no bundle do browser. Painel do Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: webhook do n8n para envio de mensagem pelo CRM (tem default no código).
# NEXT_PUBLIC_N8N_WEBHOOK_ENVIAR_MSG=
# Evolution API (WhatsApp). SEM NEXT_PUBLIC_: a chave envia mensagem em nome
# da clínica, então nunca pode ir para o bundle do navegador.
EVOLUTION_API_URL=https://sua-evolution.exemplo.host
EVOLUTION_API_KEY=
# Nome da instância conectada (endpoint /message/sendText/<instancia>)
EVOLUTION_INSTANCE=
