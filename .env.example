# ── Supabase (projeto Meraki) ────────────────────────────────────────────────
# A URL é conferida no boot: se não contiver `hcexbbmgfekpaakerfys`, a
# aplicação NÃO SOBE (`banco errado — este painel é do Meraki`). Ver
# src/lib/env.ts. Isso existe porque este repositório é um clone do painel
# antigo, que apontava para o banco de produção de uma clínica real.
NEXT_PUBLIC_SUPABASE_URL=https://hcexbbmgfekpaakerfys.supabase.co

# Pública por design do Supabase — vai no bundle. Quem protege os dados é a
# RLS: toda policy exige `authenticated` e filtra por `meus_tenants()`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IGNORA a RLS. Só pode existir em route handler; nunca em componente.
# Sem `NEXT_PUBLIC_`, jamais — é o prefixo que impede o Next de embuti-la no
# bundle do navegador. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# Sem `NEXT_PUBLIC_`: a chave manda mensagem em nome da clínica. No navegador,
# qualquer um dispararia WhatsApp pelo número dela.
# ⚠️ Precisam estar cadastradas TAMBÉM na Vercel — faltando lá, o envio quebra
# em produção sem nada de errado no build.
EVOLUTION_API_URL=https://sua-evolution.exemplo.host
EVOLUTION_API_KEY=

# Nome da instância conectada; monta o path /message/sendText/<instancia>.
# ⚠️ Escolha pelo número, não pelo nome bonito: instâncias de negócios
# diferentes convivem no mesmo servidor, e a errada manda WhatsApp do número
# errado para cliente de verdade.
EVOLUTION_INSTANCE=
